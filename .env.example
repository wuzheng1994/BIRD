# Aliyun DashScope / Bailian API key (required only when finalize_report
# falls back to an LLM, or when --retrieve / --archive is used)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=

# Optional local BGP dump root. Default: <repo>/data/ribs
# Expected layout: $RCA_DUMP_ROOT/<event_name>/rib/  and  .../update/
# RCA_DUMP_ROOT=/path/to/event_new
